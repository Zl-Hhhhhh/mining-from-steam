      "235839791"
    ],
    "source_languages": [
      "schinese"
    ],
    "lexical_categories_diagnostic": [
      "story_characters"
    ],
    "cosine_to_center": 0.8742021918296814
  },
  {
    "cluster": 3,
    "rank": 2,
    "unit_id": "Sb63bda8235d0a732c04d",
    "text": "剧情和武器方面都很强，体验不错，",
