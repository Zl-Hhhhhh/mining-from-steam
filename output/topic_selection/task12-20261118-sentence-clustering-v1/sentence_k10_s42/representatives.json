      "238998076"
    ],
    "source_languages": [
      "schinese"
    ],
    "lexical_categories_diagnostic": [
      "story_characters"
    ],
    "cosine_to_center": 0.8708587884902954
  },
  {
    "cluster": 3,
    "rank": 3,
    "unit_id": "S27b16488b94dde441882",
    "text": "我很喜欢的一个游戏，不管是背景还是剧情还是玩法我都很喜欢",
